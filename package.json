{
  "name": "sec-ownership-disclosures",
  "version": "0.3.0",
  "description": "Build a queryable lake of SEC ownership disclosures: insider Form 3/4/5 transactions and institutional 13F/13D/13G holdings, from official EDGAR sources.",
  "keywords": [
    "sec",
    "edgar",
    "insider-trading",
    "form-4",
    "form-3",
    "form-5",
    "13f",
    "institutional-holdings",
    "ownership",
    "disclosures",
    "point-in-time",
    "parquet",
    "finance",
    "dataset"
  ],
  "homepage": "https://github.com/austin-starks/sec-ownership-disclosures#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/austin-starks/sec-ownership-disclosures.git"
  },
  "bugs": {
    "url": "https://github.com/austin-starks/sec-ownership-disclosures/issues"
  },
  "author": "Austin Starks",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sec-ownership-disclosures": "dist/cli.js",
    "sec-backfill": "dist/cli/secBackfill.js",
    "sec-integrity": "dist/cli/secIntegrity.js",
    "sec-lags": "dist/cli/secLags.js"
  },
  "files": [
    "dist",
    "README.md",
    "METHODOLOGY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "verify:release": "npm run build && npm test && npm pack --dry-run",
    "typecheck:examples": "tsc --noEmit --strict --esModuleInterop --skipLibCheck --target ES2020 --moduleResolution node examples/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "cheerio": "^1.2.0",
    "hyparquet": "^1.31.1",
    "hyparquet-compressors": "^1.1.2",
    "jszip": "^3.10.2",
    "moment-timezone": "^0.5.46"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
